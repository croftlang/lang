// Std.Http: requests to web servers. A program imports what it needs with
// `use { Http, Response, HttpError } from Std.Http`, lists `Http` in `calls`,
// and names an adapter for it in dn.toml: `CurlHttp` on machines with
// libcurl, linked with `-lcurl`, or one of its own.
context Http {
    publish { Http, Response, HttpError, Unreachable, TimedOut, TooLarge, CurlHttp }

    use { Map } from Std.Collections

    // The server couldn't be reached, or the connection broke.
    error Unreachable

    // The server took longer than 30 seconds to answer.
    error TimedOut

    // The answer holds more than a `Bytes` can.
    error TooLarge

    enum HttpError {
        include Unreachable
        include TimedOut
        include TooLarge
    }

    // What the server answered: its status, such as 200 or 404, its headers,
    // with names in lower case, and the body.
    value Response {
        status: Int where Range(0, 999)
        headers: Map<String, String> where Length(0, 16)
        body: Bytes
    }

    port Http {
        fn get(url: String where Length(1, 128)): Result<Response, HttpError>
        fn post(url: String where Length(1, 128), body: Bytes): Result<Response, HttpError>
        fn put(url: String where Length(1, 128), body: Bytes): Result<Response, HttpError>
        fn delete(url: String where Length(1, 128)): Result<Response, HttpError>
    }

    // Requests through libcurl, which also handles HTTPS.
    adapter CurlHttp for Http = {
        fn get(url) = native dn_http_get(url)
        fn post(url, body) = native dn_http_post(url, body)
        fn put(url, body) = native dn_http_put(url, body)
        fn delete(url) = native dn_http_delete(url)
    }
}
