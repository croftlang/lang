// Values, enums, lists, strings and matching, checked at run time.
context Checks

use { starts_with, to_upper, to_int, split, to_bytes, to_text } from Std.Text
use { Decimal, abs, max, min } from Std.Numbers

error WrongAnswer

enum Shape {
    Square(side: Int)
    Circle
}

value Point {
    x: Int where Range(0, 255)
    y: Int where Range(0, 255)
}

const START_X: Int = 3

value Score: Int where Range(0, 999)

value Name: String where Length(1, 8)

fn bonus(score: Score): Score = Score(score.value + 10)

fn greet(name: Name): String = "Hello, " + name.value
const FIRE: Int = 1 << 4

fn check(ok: Bool): Result<Unit, WrongAnswer> = {
    if ok {
        Ok(Unit)
    }
    Err(WrongAnswer)
}

fn distance(a: Point, b: Point): Int = abs(a.x - b.x) + abs(a.y - b.y)

fn area(shape: Shape): Int = match shape {
    Square(side) -> side * side
    Circle -> 0
}

fn is_square(shape: Shape): Bool = match shape {
    Square(side) -> true
    _ -> false
}

fn anything(shape: Shape): Int = match shape {
    _ -> 7
}

fn with_tax(price: Decimal<2>): Decimal<2> = price * 1.20

fn share(total: Decimal<2>, people: Int): Decimal<2> = total / people

fn first_long(words: List<String>): Option<String> = words.find(w -> w.length > 3)

service Start(): Result<Unit, WrongAnswer> {
    calls Arguments
} = {
    let a = Point { x: START_X, y: 4 }
    let b = a with { x: 10 }
    check(distance(a, b) == 7)?
    check(b != a)?
    check(a == Point { x: 3, y: 4 })?
    check(area(Shape.Square(side: 5)) == 25)?
    check(area(Shape.Circle) == 0)?
    check(is_square(Shape.Square(side: 2)) && !is_square(Shape.Circle) && anything(Shape.Circle) == 7)?
    let none = arguments.all()
    check(none.is_empty)?
    let words = none.add("one").add("three").add("eleven")
    check(words.length == 3)?
    check(words.filter(w -> w.length > 3).length == 2)?
    check(words.map(w -> w.length).sum(n -> n) == 14)?
    check(words.contains("three"))?
    check(first_long(words).unwrap_or("") == "three")?
    check(words.min_by(w -> w.length).map(w -> w.length).unwrap_or(0) == 3)?
    let joined = "dun" + "geon"
    check(joined == "dungeon" && joined.starts_with("dun") && joined.to_upper() == "DUNGEON")?
    check("42".to_int().unwrap_or(0) == 42 && "x".to_int().is_none)?
    check("a,b,c".split(",").length == 3)?
    check(max(3, 9) - min(3, 9) == 6)?
    let keys = 0b0001_0011
    check(keys & FIRE != 0 && keys & 4 == 0)?
    check((keys | 4) ^ 1 == 0b1_0110 && ~0 == -1)?
    let amount = words.length
    check(1 << amount == 8 && -16 >> 2 == -4 && -1 << 1 == -2)?
    let price: Decimal<2> = 2.50
    check(with_tax(price) == 3 && price + 1 == 3.50 && price * 3 == 7.50)?
    check(share(10, 3) == 3.33 && share(0.05, 2) == 0.02 && share(0.07, 2) == 0.04)?
    check(price / 0.5 == 5 && -price < 0 && price.round() == 2)?
    let best: Score = 100
    check(bonus(best).value == 110 && best == Score(100) && best != Score(5))?
    check(greet("Bri") == "Hello, Bri")?
    let header: Bytes = [0x44, 0x4E, 1]
    check(header.length == 3 && header.get(0) == Some(68) && header.get(3).is_none)?
    check(header.add(255).slice(2, 4) == [1, 255] && !header.is_empty)?
    check("DN".to_bytes() == header.slice(0, 2) && header.slice(0, 2).to_text() == "DN")?
    let owed: Decimal<2> = -0.05
    check(price.to_string() == "2.50" && owed.to_string() == "-0.05")?
    Unit
}
