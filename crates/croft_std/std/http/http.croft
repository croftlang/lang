// Std.Http: requests to web servers. A program imports what it needs with
// `import { Http, Response, HttpError } from Std.Http`, lists it in its contract
// with `calls { Http }`, and names an adapter for it in croft.toml: `CurlHttp` on machines with
// libcurl, linked with `-lcurl`, or one of its own.
context Http {
    export { Http, Response, HttpError, Unreachable, TimedOut, TooLarge, CurlHttp }

    import { Map } from Std.Collections

    // The server couldn't be reached, the connection broke, the URL isn't
    // http or https, or it redirected more than 10 times.
    error Unreachable

    // The server took longer than 30 seconds to answer.
    error TimedOut

    // The answer's body is longer than the target's `bytes_length`, as
    // many as a `Bytes` with no `Length` holds.
    error TooLarge

    enum HttpError {
        include Unreachable
        include TimedOut
        include TooLarge
    }

    // What the server answered: its status, such as 200 or 404, its headers,
    // with names in lower case, and the body. After redirects, all three come
    // from the last answer. Headers longer than the target's
    // `strings_length` are left out, as are any past the first 16.
    value Response {
        status: Int where Range(0, 999)
        headers: Map<String, String> where Length(0, 16)
        body: Bytes
    }

    // Each request sends the URL, at most 1024 characters, borrowed for the
    // call so it makes no other string as long, and up to 8
    // headers, by name and value, such as `["Accept": "text/plain"]`, or
    // `[:]` for none.
    port Http {
        fn get(
            url: String where Length(1, 1024),
            headers: Map<String, String> where Length(0, 8),
        ): Result<Response, HttpError>
        fn post(
            url: String where Length(1, 1024),
            headers: Map<String, String> where Length(0, 8),
            body: Bytes,
        ): Result<Response, HttpError>
        fn put(
            url: String where Length(1, 1024),
            headers: Map<String, String> where Length(0, 8),
            body: Bytes,
        ): Result<Response, HttpError>
        fn delete(
            url: String where Length(1, 1024),
            headers: Map<String, String> where Length(0, 8),
        ): Result<Response, HttpError>
    }

    // Requests through libcurl, which also handles HTTPS. It speaks only
    // http and https, on the first request and on every redirect, and
    // follows at most 10 redirects. A header whose name or value holds a
    // carriage return, a line feed or a NUL, which could slip another
    // header or request into this one, or whose name is empty or holds a
    // colon, fails the request with `Unreachable` before anything is sent.
    adapter CurlHttp for Http = {
        fn get(url, headers) = native croft_http_get(url, headers)
        fn post(url, headers, body) = native croft_http_post(url, headers, body)
        fn put(url, headers, body) = native croft_http_put(url, headers, body)
        fn delete(url, headers) = native croft_http_delete(url, headers)
    }
}
