// Breaks one constraint, chosen by the command-line argument, so the test can see
// each kind of check stop the program. Each value depends on the arguments, so
// it is only known while running; a value known when compiling is an error then.
context Clinic {
    use { Decimal } from Std.Numbers
    use { trim } from Std.Text

    constraint Even(number: Int) = number % 2 == 0

    value Dose {
        amount: Int where Range(1, 50)
    }

    fn heal(amount: Int where Range(1, 50)): Int = amount * 2

    value Score: Int where Range(0, 999)

    // Kept in eight characters of its own, not the size of every string.
    value Patient {
        name: String where Length(1, 8)
    }

    fn pay(amount: Decimal<2> where Range(0.01, 99.99)): Decimal<2> = amount

    fn half(number: Int): Int where Even = number / 2

    // A constraint with no name, written as a line of the contract.
    fn move_bed(from: Int, to: Int): Int {
        from != to
    } = to

    // Its constraint is in the contract, which checks the same as writing it
    // inline. Its Length gives every list of whole numbers room for eight, so
    // the three of `doses` below is what stops that list, not a full list.
    fn count(numbers: List<Int> where Length(0, 8)): Int {
        numbers where each Even
    } = numbers.length

    // Room for two numbers, and no more.
    fn pair(): List<Int> where Length(0, 2) = []

    service Start(): Unit {
        calls { Arguments }
    } = {
        let chosen = Arguments.all()
        if chosen.contains("argument") {
            let healed = heal(chosen.length * 70)
        }
        if chosen.contains("result") {
            let halved = half(chosen.length * 4 + 2)
        }
        if chosen.contains("field") {
            let dose = Dose { amount: chosen.length * 70 }
        }
        if chosen.contains("each") {
            let counted = count([2, chosen.length * 2 + 1])
        }
        if chosen.contains("contract") {
            let moved = move_bed(chosen.length, chosen.length)
        }
        if chosen.contains("score") {
            let score = Score(chosen.length * 5000)
        }
        if chosen.contains("pay") {
            let paid = pay(chosen.length * 120)
        }
        if chosen.contains("name") {
            let patient = Patient { name: "Bartholomew".trim() }
        }
        if chosen.contains("join") {
            let joined = "a sentence of twenty " + "and another of twenty"
        }
        if chosen.contains("let") {
            let doses: List<Int> where Length(0, 3) = []
            loop (let dose where Range(1, 5)) {
                if dose <= chosen.length * 5 {
                    set doses = doses.add(dose)
                }
            }
        }
        if chosen.contains("shift") {
            let shifted = 1 << chosen.length * 40
        }
        if chosen.contains("full") {
            let few: List<Int> where Length(0, 8) = pair()
            loop (let i where Range(1, 9)) {
                if i <= chosen.length + 9 {
                    set few = few.add(i)
                }
            }
        }
        Unit
    }
}
