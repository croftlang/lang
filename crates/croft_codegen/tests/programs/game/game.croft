// Commands, events, policies and a repository, checked at run time.
context Game

error WrongAnswer

identity BoardId for Board: Int where Range(1, 9)

aggregate Board {
    id: BoardId
    points: Int where Range(0, 1000)
    bonus: Int

    error NotFound
    error TooMany

    event Scored { total: Int }

    factory Open(id: BoardId) = Board { id, points: 0, bonus: 0 }

    command Score(amount: Int) {
        amount <= 100 or TooMany
    } = {
        set points = points + amount
        emit Scored { total: points }
    }

    command AddBonus = {
        set bonus = bonus + 1
    }
}

repository Boards for Board

policy BonusOnScore when Board.Scored {
    issue AddBonus on Board(event.source)
}

enum GameError {
    include Board.Error
    include StorageError
    include WrongAnswer
}

fn check(ok: Bool): Result<Unit, WrongAnswer> = {
    if ok {
        Ok(Unit)
    }
    Err(WrongAnswer)
}

service Play(board: Board): Result<Unit, GameError> {
    calls Boards
} = {
    boards.save(board)?
    issue Score(amount: 5) on Board(board.id)?
    issue Score(amount: 7) on Board(board.id)?
    Unit
}

// Changes a board but never saves it, so its Scored event must not reach
// the policy when this service ends.
service Tamper(board: Board): Result<Unit, GameError> = {
    let changed = issue Score(amount: 10) on board?
    check(changed.points == board.points + 10)?
}

service Start(): Result<Unit, GameError> {
    calls Boards
} = {
    let spare = Board.Open(id: 2)?
    let scored = issue Score(amount: 10) on spare?
    check(scored.points == 10 && spare.points == 0)?
    let failed = match issue Score(amount: 500) on spare {
        Ok(board) -> false
        Err(error) -> true
    }
    check(failed)?
    Play(Board.Open(id: 1)?)?
    let saved = boards.find(1)?
    check(saved.points == 12)?
    check(saved.bonus == 2)?
    Tamper(saved)?
    let after = boards.find(1)?
    check(after.points == 12 && after.bonus == 2)?
    let missing = match boards.find(2) {
        Ok(board) -> false
        Err(error) -> true
    }
    check(missing)?
    Unit
}
