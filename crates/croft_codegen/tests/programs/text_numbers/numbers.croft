// to_int on text at the edges of Int's range: a number Int can't hold
// gives None instead of wrapping round.
context Numbers

use { to_int } from Std.Text

error WrongAnswer

fn check(ok: Bool): Result<Unit, WrongAnswer> = {
    if ok {
        Ok(Unit)
    }
    Err(WrongAnswer)
}

fn number(text: String): Option<Int> = text.to_int()

service Check(): Result<Unit, WrongAnswer> = {
    check(number("0") == Some(0))?
    check(number("-0") == Some(0))?
    check(number("2147483647") == Some(2147483647))?
    check(number("-2147483648") == Some(-2147483647 - 1))?
    check(number("00002147483647") == Some(2147483647))?
    check(number("2147483648").is_none)?
    check(number("-2147483649").is_none)?
    check(number("4294967296").is_none)?
    check(number("4294967306").is_none)?
    check(number("99999999999999999999").is_none)?
    check(number("-99999999999999999999").is_none)?
    check(number("").is_none)?
    check(number("-").is_none)?
    check(number("+1").is_none)?
    check(number("12a").is_none)?
    check("2147483648".to_int().is_none)?
    check("2147483647".to_int() == Some(2147483647))?
    Ok(Unit)
}
