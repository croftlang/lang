// Prints the value of each environment variable named on the command line,
// with its length, or "unset" for one that isn't set.
context Settings {
    publish { Show }

    service Show(): Unit {
        calls { Console, Arguments, Environment }
    } = {
        let names = Arguments.all()
        loop (let index where Range(0, 3)) {
            match names.get(index) {
                Some(name) -> match Environment.get(name) {
                    Some(found) -> {
                        Console.print(found.length.to_string())
                        Console.print(found)
                    }
                    None -> Console.print("unset")
                }
                None -> break
            }
        }
    }
}

domain Program {
    contexts { Settings }
    use { Show } from Settings
} = Show()
