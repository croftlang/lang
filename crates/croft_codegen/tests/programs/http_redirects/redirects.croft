// Follows a redirect, stops in a redirect loop and refuses a file URL through
// Std.Http and CurlHttp. The test replaces SERVER with the address of a
// server it runs for the purpose.
context Fetch {
    publish { Talk }

    use { Http, Response, HttpError, Unreachable, TimedOut, TooLarge } from Std.Http
    use { to_text } from Std.Text

    // What a request came to: the error's name, or "answered".
    fn outcome(answer: Result<Response, HttpError>): String = match answer {
        Ok(_) -> "answered"
        Err(e) -> name_of(e)
    }

    // The name of an error from Std.Http.
    fn name_of(error: HttpError): String = match error {
        Unreachable -> "unreachable"
        TimedOut -> "timed out"
        TooLarge -> "too large"
    }

    service Talk(): Result<Unit, HttpError> {
        calls { Http, Console }
    } = {
        let page = Http.get("http://SERVER/moved")?
        Console.print(page.status.to_string())
        Console.print(page.body.to_text())
        Console.print(page.headers.get("x-step").unwrap_or("none"))
        Console.print(page.headers.get("location").unwrap_or("none"))
        Console.print(page.headers.length.to_string())
        Console.print(outcome(Http.get("http://SERVER/loop")))
        Console.print(outcome(Http.get("file:///etc/passwd")))
        Unit
    }
}

domain Program {
    contexts { Fetch }
    use { Talk } from Fetch
} = Talk()?
