// Std.Time's days_between and add_days across leap years and centuries,
// every day from 1 January of year 1 to 31 December 9999 in turn, and a
// clock written in Croft.
context Calendar

use { Date, Time, Clock, days_between, add_days } from Std.Time

error WrongAnswer

// Today, for the tests: always the same day and time.
adapter FixedClock for Clock = {
    fn today() = Date { year: 2026, month: 11, day: 27 }
    fn now() = Time { hour: 23, minute: 59, second: 59 }
}

fn check(ok: Bool): Result<Unit, WrongAnswer> = {
    if ok {
        Ok(Unit)
    }
    Err(WrongAnswer)
}

fn on(year: Int, month: Int, day: Int): Date = Date { year: year, month: month, day: day }

fn leap(year: Int): Bool = year % 4 == 0 && year % 100 != 0 || year % 400 == 0

fn month_length(date: Date): Int = {
    if date.month == 2 && leap(date.year) {
        29
    }
    if date.month == 2 {
        28
    }
    if date.month == 4 || date.month == 6 || date.month == 9 || date.month == 11 {
        30
    }
    31
}

// Whether `next` is the day after `date` on the calendar.
fn follows(date: Date, next: Date): Bool = {
    if date.day < month_length(date) {
        next == date with { day: date.day + 1 }
    }
    if date.month < 12 {
        next == on(date.year, date.month + 1, 1)
    }
    next == on(date.year + 1, 1, 1)
}

service Check(): Result<Unit, WrongAnswer> {
    calls { Clock }
} = {
    check(days_between(on(2000, 1, 1), on(2026, 11, 27)) == 9827)?
    check(days_between(on(2026, 11, 27), on(2000, 1, 1)) == -9827)?
    check(days_between(on(1, 1, 1), on(9999, 12, 31)) == 3652058)?
    check(days_between(on(1, 1, 1), on(1970, 1, 1)) == 719162)?
    check(days_between(on(2024, 3, 1), on(2025, 3, 1)) == 365)?
    check(add_days(on(2024, 2, 28), 1) == on(2024, 2, 29))?
    check(add_days(on(2023, 2, 28), 1) == on(2023, 3, 1))?
    check(add_days(on(1900, 2, 28), 1) == on(1900, 3, 1))?
    check(add_days(on(2000, 2, 28), 1) == on(2000, 2, 29))?
    check(add_days(on(2026, 11, 27), -10000) == on(1999, 7, 12))?
    check(add_days(on(2026, 11, 27), 0) == on(2026, 11, 27))?
    check(add_days(on(2023, 2, 30), 0) == on(2023, 3, 2))?

    let today = Clock.today()
    check(today == on(2026, 11, 27))?
    check(Clock.now().second == 59)?

    let date = on(1, 1, 1)
    loop (let days where Range(1, 3652058)) {
        let next = add_days(date, 1)
        check(follows(date, next))?
        check(days_between(on(1, 1, 1), next) == days)?
        set date = next
    }
    check(date == on(9999, 12, 31))?
}
