// Set from Std.Collections, and unique, insert and fold on lists, with
// fold's lambda taking the total and each item.
context Collections

use { Set } from Std.Collections
use { Decimal, max } from Std.Numbers

error WrongAnswer

value Tag {
    name: String where Length(0, 8)
    weight: Int where Range(0, 9)
}

fn check(ok: Bool): Result<Unit, WrongAnswer> = {
    if ok {
        Ok(Unit)
    }
    Err(WrongAnswer)
}

fn total(prices: List<Decimal<2>>): Decimal<2> = prices.fold(0.00, (sum, price) -> sum + price)

fn joined(words: List<String>): String = words.fold("", (text, word) -> text + word + ";")

fn doubled(numbers: List<Int>): List<Int> = numbers.fold([], (kept, number) -> kept + [number * 2])

fn heaviest(tags: List<Tag>): Int = tags.fold(0, (most, tag) -> max(most, tag.weight))

fn seen_rooms(rooms: List<Int>): Set<Int> where Length(0, 4) = rooms.fold([], (seen, room) -> seen.add(room))

service Check(): Result<Unit, WrongAnswer> {
    calls { Arguments }
} = {
    // Zero, but not known until the program runs.
    let count = Arguments.all().length

    let empty: Set<Int> = []
    check(empty.is_empty && empty.length == 0)?

    let numbers: Set<Int> = [3, 1, 2]
    check(numbers.length == 3 && numbers.contains(1) && !numbers.contains(4))?
    check(numbers.add(1).length == 3 && numbers.add(count + 4).length == 4)?
    check(numbers.add(1 + count) == numbers)?
    check(numbers.remove(1).items == [3, 2] && numbers.remove(9) == numbers)?
    check(numbers.items == [3, 1, 2])?
    check(numbers == [2, 3, 1] && numbers != [1, 2])?

    let names: Set<String> = ["ann", "bo"]
    check(names.add("ann").length == 2 && names.add("cy").contains("cy"))?
    check(names.remove("ann").items == ["bo"])?

    let tags: Set<Tag> = [Tag { name: "red", weight: 1 }]
    check(tags.contains(Tag { name: "red", weight: 1 }) && !tags.contains(Tag { name: "red", weight: 2 }))?

    let grown: Set<Int> where Length(0, 4) = []
    set grown = grown.add(count + 7)
    set grown = grown.add(count + 7)
    set grown = grown.add(count + 8)
    check(grown.items == [7, 8])?

    check(seen_rooms([4, 5, 4, 4, 6]).items == [4, 5, 6])?

    check([3, 1, 3, 2, 1].unique() == [3, 1, 2])?
    check(["a", "b", "a"].unique() == ["a", "b"])?
    let none: List<Int> = []
    check(none.unique().is_empty)?

    check([1, 2, 3].insert(0, 9) == [9, 1, 2, 3])?
    check([1, 2, 3].insert(1 + count, 9) == [1, 9, 2, 3])?
    check([1, 2, 3].insert(3, 9) == [1, 2, 3, 9])?
    check(none.insert(0, 5) == [5])?
    check(["b"].insert(0, "a") == ["a", "b"])?

    check([1, 2, 3, 4].fold(0, (sum, number) -> sum + number) == 10)?
    check(none.fold(7, (sum, number) -> sum + number) == 7)?
    check(total([2.50, 0.99, 10.00]) == 13.49)?
    check(joined(["a", "bc", "d"]) == "a;bc;d;")?
    check(doubled([1, 2, 3]) == [2, 4, 6])?
    check(heaviest([Tag { name: "a", weight: 3 }, Tag { name: "b", weight: 8 }, Tag { name: "c", weight: 2 }]) == 8)
}
