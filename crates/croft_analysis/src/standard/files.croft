// Std.Files: reading and writing whole files. A program imports what it
// needs with `use { Files, FileError } from Std.Files`, lists `Files` in
// `calls`, and names an adapter for it in croft.toml: `StdioFiles` on machines
// with C's stdio, or one of its own, such as for a DivMMC.
context Files {
    publish { Files, FileError, NotFound, NoRoom, Unreadable, StdioFiles }

    // There is no file at that path.
    error NotFound

    // The disk is full, or the file holds more than a `Bytes` can.
    error NoRoom

    // The machine couldn't read or write it, for any other reason.
    error Unreadable

    enum FileError {
        include NotFound
        include NoRoom
        include Unreadable
    }

    port Files {
        // The whole file.
        fn read(path: String): Result<Bytes, FileError>

        // Replaces the file, or makes it.
        fn write(path: String, data: Bytes): Result<Unit, FileError>

        // Adds to the end of the file, or makes it.
        fn append(path: String, data: Bytes): Result<Unit, FileError>

        fn exists(path: String): Bool

        fn remove(path: String): Result<Unit, FileError>

        // The name of everything in the folder, in order, with a `/` on the
        // end of each folder's name. Fails with `NotFound` when there is no
        // such folder, and `NoRoom` when there are more names than a
        // `List<String>` holds or a name is longer than a string.
        fn list(folder: String): Result<List<String>, FileError>
    }

    // Files through C89's stdio: fopen, fread, fwrite and remove. Listing a
    // folder needs POSIX's opendir, so on a machine without it, such as an
    // 8-bit one, `list` fails with `Unreadable`.
    adapter StdioFiles for Files = {
        fn read(path) = native croft_files_read(path)
        fn write(path, data) = native croft_files_write(path, data)
        fn append(path, data) = native croft_files_append(path, data)
        fn exists(path) = native croft_files_exists(path)
        fn remove(path) = native croft_files_remove(path)
        fn list(folder) = native croft_files_list(folder)
    }
}
