// Adapters written in dn, for running the game in tests.
context Platform

adapter NullScreen for Screen on target test {
    fn clear() = Unit
    fn draw_sprite(sprite, at) = Unit
    fn draw_text(text, at) = Unit
}

adapter ScriptedKeyboard for Keyboard on target test {
    keys: List<Key> where Length(0, 32)

    fn pressed() = {
        if keys.is_empty {
            None
        }
        let next = keys.first
        set keys = keys.drop(1)
        Some(next)
    }
}

adapter MemoryStorage for Storage on target test {
    files: List<Int> where Length(0, 256)

    fn load(name) = Ok(files)
    fn store(name, data) = {
        set files = data
        Ok(Unit)
    }
}
