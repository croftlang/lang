// The starting data: the room the player starts in, kept in memory for now.
context Dungeon

// Saves the first room, so the game has somewhere to start.
service SetUpRooms(): Result<Unit, StorageError> {
    uses Rooms
} = rooms.save(first_room())

// Two enemies between the player and the exit.
fn first_room(): Room = Room {
    id: FIRST_ROOM
    player: Room.Player { id: 1, position: Position { x: 16, y: 16 }, lives: 3 }
    enemies: [
        Room.Enemy { id: 0, position: Position { x: 64, y: 64 }, hit_points: 20 },
        Room.Enemy { id: 1, position: Position { x: 128, y: 96 }, hit_points: 30 }
    ]
    treasure: []
    exit: Position { x: 232, y: 168 }
}
