{
  "name": "croft-language",
  "displayName": "Croft",
  "description": "Syntax highlighting, errors as you type, hover and go to definition for the Croft domain language.",
  "version": "0.1.0",
  "publisher": "briward",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "croft",
        "aliases": [
          "Croft",
          "croft"
        ],
        "extensions": [
          ".croft",
          ".cro"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "croft",
        "scopeName": "source.croft",
        "path": "./syntaxes/croft.tmLanguage.json"
      },
      {
        "scopeName": "markdown.croft.codeblock",
        "path": "./syntaxes/croft.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.croft": "croft"
        }
      }
    ],
    "configuration": {
      "title": "Croft",
      "properties": {
        "croft.server.path": {
          "type": "string",
          "default": "croft",
          "description": "The `croft` command, which runs the language server with `croft lsp`. Set this when `croft` is not on your PATH."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:croft"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
