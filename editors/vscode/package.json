{
  "name": "croft",
  "displayName": "Croft",
  "description": "Croft language support: highlighting, errors as you type, hover, go to definition and completion through croft lsp.",
  "version": "0.1.0",
  "publisher": "croftlang",
  "icon": "icons/croft.png",
  "homepage": "https://croftlang.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/croftlang/lang.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/croftlang/lang/issues"
  },
  "license": "MIT OR Apache-2.0",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "croft",
        "aliases": [
          "Croft",
          "croft"
        ],
        "extensions": [
          ".croft",
          ".cro"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/croft-file-light.svg",
          "dark": "./icons/croft-file-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "croft",
        "scopeName": "source.croft",
        "path": "./syntaxes/croft.tmLanguage.json"
      },
      {
        "scopeName": "markdown.croft.codeblock",
        "path": "./syntaxes/croft.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.croft": "croft"
        }
      }
    ],
    "configuration": {
      "title": "Croft",
      "properties": {
        "croft.server.path": {
          "type": "string",
          "default": "croft",
          "description": "The `croft` command, which runs the language server with `croft lsp`. Set this when `croft` is not on your PATH."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:croft"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
