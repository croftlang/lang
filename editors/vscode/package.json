{
  "name": "b-language",
  "displayName": "b",
  "description": "Syntax highlighting, errors as you type, hover and go to definition for the b domain language.",
  "version": "0.1.0",
  "publisher": "briward",
  "license": "MIT",
  "engines": {
    "vscode": "^1.82.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [
      {
        "id": "b",
        "aliases": [
          "b"
        ],
        "extensions": [
          ".b"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "b",
        "scopeName": "source.b",
        "path": "./syntaxes/b.tmLanguage.json"
      },
      {
        "scopeName": "markdown.b.codeblock",
        "path": "./syntaxes/b.markdown.tmLanguage.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.b": "b"
        }
      }
    ],
    "configuration": {
      "title": "b",
      "properties": {
        "b.server.path": {
          "type": "string",
          "default": "b",
          "description": "The `b` command, which runs the language server with `b lsp`. Set this when `b` is not on your PATH."
        }
      }
    }
  },
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:b"
  ],
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
